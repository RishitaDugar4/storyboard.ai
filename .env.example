# Copy to .env and fill in. Never commit .env.
ENV=local

# Auth gate (single tenant). Generate a secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_PASSPHRASE=change-me
SESSION_SECRET=dev-only-insecure-secret
SESSION_COOKIE_SECURE=false

# Local host Postgres (default). For the compose stack use port 5433:
#   postgresql+asyncpg://hbz:hbz@localhost:5433/hbday_zee
DATABASE_URL=postgresql+asyncpg://localhost/hbday_zee_dev
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=hbz

# --- providers ------------------------------------------------------------
# Text stage (story analysis + storyboard). Any of: gemini | anthropic | fake.
# Defaults to gemini so one Google key covers both text and Veo.
AI_TEXT_PROVIDER=gemini
# Optional model override. Defaults: gemini-3.1-pro-preview / claude-opus-5
# AI_TEXT_MODEL=gemini-3.8-flash

# Narration (TTS) is paced client-side so a `generate_all` fan-out cannot
# outrun the provider's per-minute quota. Gemini's Tier 1 TTS ceiling is
# 10/min; 8 is the default and leaves room for a retry in the same window.
# Raise it if your tier is higher, or set 0 to disable pacing entirely.
# AI_SPEECH_RPM=8

GEMINI_API_KEY=        # text (if AI_TEXT_PROVIDER=gemini) and Veo
FAL_KEY=               # stills AND image-to-video clips (Kling / Hailuo)

# --- motion (image-to-video) ----------------------------------------------
# Every shot's approved still becomes the first frame of a generated clip.
# Set to `fake` to run the whole pipeline against a locally synthesised MP4
# and spend nothing; leave unset to use the real provider the catalogue entry
# names. `make dev-fake` sets this for you.
# AI_VIDEO_PROVIDER=fake
#
# `make models` lists the catalogue with prices. The default is
# kling-2.5-turbo-i2v: the bake-off measured it at 79s, 1920x1080, and within
# 42ms of its requested duration (docs/adr/001-bakeoff-results.md).
ANTHROPIC_API_KEY=     # only if AI_TEXT_PROVIDER=anthropic
