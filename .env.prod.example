# Copy to .env.prod ON THE SERVER and fill in. Never commit it.
# Generate secrets:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=prod

# --- public address -------------------------------------------------------
# Bare domain or subdomain, no scheme. Its DNS A record must already point at
# this box, or Caddy cannot obtain a certificate.
SITE_ADDRESS=zee.example.com
ACME_EMAIL=you@example.com

# --- auth -----------------------------------------------------------------
APP_PASSPHRASE=
SESSION_SECRET=
SESSION_COOKIE_SECURE=true

# --- database -------------------------------------------------------------
POSTGRES_PASSWORD=

# --- providers ------------------------------------------------------------
ANTHROPIC_API_KEY=
FAL_KEY=
GEMINI_API_KEY=
