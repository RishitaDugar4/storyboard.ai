# Copy to .env and fill in. Never commit .env.
ENV=local

# Auth gate (single tenant). Generate a secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_PASSPHRASE=change-me
SESSION_SECRET=dev-only-insecure-secret
SESSION_COOKIE_SECURE=false

# Local host Postgres (default). For the compose stack use port 5433:
#   postgresql+asyncpg://hbz:hbz@localhost:5433/hbday_zee
DATABASE_URL=postgresql+asyncpg://localhost/hbday_zee_dev
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=hbz

# --- providers ------------------------------------------------------------
# Text stage (story analysis + storyboard). Any of: gemini | anthropic | fake.
# Defaults to gemini so one Google key covers both text and Veo.
AI_TEXT_PROVIDER=gemini
# Optional model override. Defaults: gemini-3.1-pro-preview / claude-opus-5
# AI_TEXT_MODEL=gemini-3.8-flash

GEMINI_API_KEY=        # text (if AI_TEXT_PROVIDER=gemini) and Veo
FAL_KEY=               # Kling / Hailuo motion providers
ANTHROPIC_API_KEY=     # only if AI_TEXT_PROVIDER=anthropic
